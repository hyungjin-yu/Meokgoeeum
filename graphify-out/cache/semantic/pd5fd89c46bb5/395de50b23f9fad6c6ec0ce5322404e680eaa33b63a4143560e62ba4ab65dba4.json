{"nodes": [{"id": "gihoekseo_14_doc", "label": "14 \ubc38\ub7f0\uc2a4 \uc218\uce58 \uc2dc\ud2b8 (Balance Sheet)", "file_type": "document", "source_file": "\uae30\ud68d\uc11c/14 \ubc38\ub7f0\uc2a4 \uc218\uce58 \uc2dc\ud2b8.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "gihoekseo_14_player_stats", "label": "\ud50c\ub808\uc774\uc5b4 \uae30\ubcf8 \uc2a4\ud0ef", "file_type": "concept", "source_file": "\uae30\ud68d\uc11c/14 \ubc38\ub7f0\uc2a4 \uc218\uce58 \uc2dc\ud2b8.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "gihoekseo_14_combo_damage_addition", "label": "\uae30\ubcf8 \ucf64\ubcf4 \ub300\ubbf8\uc9c0 \uc2e0\uaddc \uc815\uc758", "file_type": "rationale", "source_file": "\uae30\ud68d\uc11c/14 \ubc38\ub7f0\uc2a4 \uc218\uce58 \uc2dc\ud2b8.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uae30\uc874\uc5d0\ub294 \uc2a4\ud0ac \ub300\ubbf8\uc9c0\ub9cc \uc815\uc758\ub3fc \uc788\uace0 \uac00\uc7a5 \ub9ce\uc774 \uc4f0\ub294 \uae30\ubcf8 \ucf64\ubcf4 \ub300\ubbf8\uc9c0\uac00 \uc5c6\uc5b4 \ubcf4\uc2a4 DPS \uac80\uc99d\uc774 \ubd88\uac00\ub2a5\ud588\uc74c. \ubd93 \uacf5\uaca9\ub825 10 \uae30\uc900 3\ud0c0 \ucf64\ubcf4(6+7+10=23), \ucf64\ubcf4 1\ud68c\uc804 73\ud504\ub808\uc784(\u22481.22\ucd08) \uae30\uc900 \uc21c\uc218 \ucf64\ubcf4 DPS \uc57d 18.9/\ucd08\ub85c \uc2e0\uaddc \uc0b0\uc815."}, {"id": "gihoekseo_14_boss_dps_verification", "label": "\ubcf4\uc2a4 DPS \uc5ed\uc0b0 \uac80\uc99d (\ucd08\uae30 \uac00\uc124)", "file_type": "rationale", "source_file": "\uae30\ud68d\uc11c/14 \ubc38\ub7f0\uc2a4 \uc218\uce58 \uc2dc\ud2b8.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\ud398\uc774\uc988\ub2f9 \uccb4\uac10 \uc804\ud22c \uc2dc\uac04 60~90\ucd08 \ubaa9\ud45c, \uc2e4\ud6a8 \uad50\uc804 \ube44\uc728 40